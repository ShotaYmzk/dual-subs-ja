{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "1.1.0",
  "description": "__MSG_appDesc__",
  "permissions": [
    "declarativeNetRequest",
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:11434/*",
    "http://localhost:11434/*",
    "https://*.hf.co/*",
    "https://*.huggingface.co/*",
    "https://huggingface.co/*"
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_appName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.primevideo.com/*",
        "*://*.amazon.co.jp/gp/video/*",
        "*://*.amazon.co.jp/-/*/gp/video/*",
        "*://*.amazon.com/gp/video/*",
        "*://*.amazon.com/-/*/gp/video/*",
        "*://*.netflix.com/*",
        "*://www.youtube.com/*"
      ],
      "js": [
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.primevideo.com/*",
        "*://*.amazon.co.jp/gp/video/*",
        "*://*.amazon.co.jp/-/*/gp/video/*",
        "*://*.amazon.com/gp/video/*",
        "*://*.amazon.com/-/*/gp/video/*",
        "*://*.netflix.com/*",
        "*://www.youtube.com/*"
      ],
      "js": [
        "ttml.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "minimum_chrome_version": "137",
  "default_locale": "ja",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}